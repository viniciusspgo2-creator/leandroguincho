# ===== Leandro Guincho — Environment Variables =====
# Copy this file to `.env` locally (already done in dev sandbox).
# On Vercel, add these in Project Settings → Environment Variables.

# --- DATABASE (REQUIRED for production on Vercel) ---
# Local dev: SQLite file path (works in this sandbox).
# Vercel prod: PostgreSQL connection string from Neon / Supabase / Vercel Postgres.
#
# STEP 1 (Vercel deploy): create a free Postgres instance at https://neon.tech
# STEP 2: copy the connection string (looks like postgresql://user:pass@host/db?sslmode=require)
# STEP 3: set DATABASE_URL in Vercel env vars
# STEP 4: edit prisma/schema.prisma — change `provider = "sqlite"` to `provider = "postgresql"`
# STEP 5: Vercel will run `prisma generate && next build` (see package.json `build` script)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# --- SITE URL (canonical) ---
# Used to build absolute URLs (sitemap, OG tags, JSON-LD).
# Use your final Vercel domain or custom domain.
NEXT_PUBLIC_SITE_URL=https://guinchoituiutaba.com.br

# --- ANALYTICS (optional) ---
# Leave empty to disable. Fill only what you use.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# --- NOTES ---
# - No SMTP/email service is configured: the public contact form opens WhatsApp directly.
# - No third-party auth: admin login is cookie-based with first-time password setup.
# - No file uploads: admin blog cover images use plain URL input (recommended: upload to
#   Vercel Blob / Cloudinary / S3 and paste the URL).
